# Firebase 에뮬레이터 모드 (E2E 인증 테스트 전용)
# vite --mode emulator 로 로드된다. VITE_FIREBASE_* 등 나머지 값은 .env.local에서 병합된다.
# 이 플래그가 켜지면 App Check가 비활성화되고 Auth/Firestore/Functions가 로컬 에뮬레이터에 연결된다.
VITE_USE_EMULATOR=true

# 프로젝트 ID는 demo- 값으로 덮어쓴다(.env.local·CI의 .env보다 이 파일이 우선한다).
# 에뮬레이터도 --project demo-vehicle-log로 뜨므로 데이터 공간이 맞고, Storage처럼 에뮬레이터에
# 연결하지 않은 서비스로 요청이 새면 존재하지 않는 프로젝트로 가서 실패한다 — 운영에 닿지 않는다.
VITE_FIREBASE_PROJECT_ID=demo-vehicle-log
