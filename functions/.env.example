# === Cloud Functions 환경변수 템플릿 ===
# 이 파일을 `functions/.env`로 복사한 뒤 값을 채운다. functions/.env는 .gitignore 대상이다.
# 배포 시에는 GitHub Secrets(FUNCTIONS_ENV_FILE)로 생성된다.
#
# ⚠️ 실제 크리덴셜은 이 파일에 넣지 않는다.
#    GMAIL_APP_PASSWORD, EMAILJS_PRIVATE_KEY, ALIMTALK_PROXY_TOKEN,
#    SLACK_SIGNING_SECRET, SLACK_TOKEN_ENC_KEY, SLACK_CLIENT_ID,
#    SLACK_CLIENT_SECRET, SLACK_STATE_SECRET 은 Secret Manager로 관리한다.
#      firebase functions:secrets:set <NAME>
#    functions/.env에 같은 키가 있으면 이름 충돌로 배포가 거부된다.
#    → functions/src/core/params.ts 참고

# 발신 Gmail 주소 (비밀번호는 Secret Manager의 GMAIL_APP_PASSWORD)
GMAIL_USER=

# 알림톡 Cafe24 프록시 엔드포인트 URL (인증 토큰은 Secret Manager의 ALIMTALK_PROXY_TOKEN)
ALIMTALK_PROXY_URL=

# 기관 신청 등 운영 알림을 받을 관리자 이메일
ADMIN_NOTIFICATION_EMAIL=

# Functions용 Sentry DSN
SENTRY_DSN_FUNCTIONS=

# 테스트 화이트리스트 허용 플래그 (운영에서는 비워 둔다)
ALLOW_TEST_WHITELIST=
