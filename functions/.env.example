# === Cloud Functions 환경변수 템플릿 ===
# 이 파일을 `functions/.env`로 복사한 뒤 값을 채운다. functions/.env는 .gitignore 대상이다.
# 배포 시에는 GitHub Secrets(FUNCTIONS_ENV_FILE)로 생성된다.
#
# ⚠️ 실제 크리덴셜은 이 파일에 넣지 않는다.
#    GEMINI_API_KEY, GMAIL_APP_PASSWORD, EMAILJS_PRIVATE_KEY, ALIMTALK_PROXY_TOKEN,
#    SLACK_SIGNING_SECRET, SLACK_TOKEN_ENC_KEY, SLACK_CLIENT_ID,
#    SLACK_CLIENT_SECRET, SLACK_STATE_SECRET 은 Secret Manager로 관리한다.
#      firebase functions:secrets:set <NAME>
#    functions/.env에 같은 키가 있으면 이름 충돌로 배포가 거부된다.
#    → functions/src/core/params.ts 참고
#
# 이 목록은 `npm run check:functions-env`가 코드(defineString/process.env)와 대조한다.
# 키를 추가·제거하면 README.md의 functions/.env 블록도 함께 고쳐야 검사를 통과한다.

# 발신 Gmail 주소 (비밀번호는 Secret Manager의 GMAIL_APP_PASSWORD)
GMAIL_USER=

# 알림톡 Cafe24 프록시 엔드포인트 URL (인증 토큰은 Secret Manager의 ALIMTALK_PROXY_TOKEN)
ALIMTALK_PROXY_URL=

# 기관 신청 등 운영 알림을 받을 관리자 이메일
ADMIN_NOTIFICATION_EMAIL=

# Functions용 Sentry DSN
SENTRY_DSN_FUNCTIONS=

# 운영 알림 Discord 웹훅 URL (선택). captureError가 Sentry와 별개로 여기에도 보낸다 —
# 비워 두면 Cloud Functions 예외 알림이 Discord로는 가지 않는다.
DISCORD_WEBHOOK_URL=

# Firestore 백업 대상 버킷 (선택). 비우면 `{projectId}-backups`를 쓴다.
# ⚠️ 기본 Storage 버킷(.firebasestorage.app)을 넣으면 안 된다 — Firestore 관리형 export는
#    DB와 같은 위치의 버킷만 받는데 기본 버킷은 us-east1, Firestore는 asia-northeast3다.
FIRESTORE_BACKUP_BUCKET=


# 티맵 경로/지오코딩 API 키 (tmapProxy, routeEstimate, backfillOrgCoords)
TMAP_API_KEY=

# 공공데이터포털 공휴일 API 키 (syncHolidays, holidayProxy)
HOLIDAY_API_KEY=

# 테스트 화이트리스트 허용 플래그 (운영에서는 비워 둔다)
ALLOW_TEST_WHITELIST=

# Sentry 릴리즈(배포 커밋 SHA). **직접 채우지 않는다** — 배포 워크플로가 배포할 때마다
# functions/.env에 덧붙인다. 비어 있으면 Functions 에러에 릴리즈가 붙지 않을 뿐 동작에는 지장 없다.
SENTRY_RELEASE=
