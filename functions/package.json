{
    "name": "functions",
    "description": "Cloud Functions for 차량운행일지",
    "scripts": {
        "build": "tsc",
        "gcp-build": "",
        "build:watch": "tsc --watch",
        "type-check": "tsc --noEmit",
        "test": "jest --verbose --testPathIgnorePatterns=emulator",
        "test:coverage": "jest --coverage --testPathIgnorePatterns=emulator",
        "test:emulator": "jest --verbose --runInBand --testPathPatterns=\"emulator\\.test\"",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/functions/src/index.js",
    "dependencies": {
        "@emailjs/nodejs": "^5.0.2",
        "@google/genai": "^2.19.0",
        "@sentry/node": "^10.72.0",
        "firebase-admin": "^14.3.0",
        "firebase-functions": "^7.3.2",
        "googleapis": "^176.0.0",
        "nodemailer": "^9.0.6"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.4.0",
        "@types/nodemailer": "^8.0.1",
        "babel-jest": "^30.5.1",
        "jest": "^30.5.0",
        "ts-jest": "^29.4.12",
        "typescript": "^5.7.0"
    },
    "jest": {
        "testEnvironment": "node",
        "coverageProvider": "v8",
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/__tests__/**",
            "!src/**/*.d.ts",
            "!src/index.ts"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 43,
                "branches": 74,
                "functions": 46,
                "lines": 43
            }
        },
        "maxWorkers": "50%",
        "roots": [
            "<rootDir>/src"
        ],
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "diagnostics": false,
                    "tsconfig": "tsconfig.test.json"
                }
            ],
            "^.+\\.m?js$": [
                "babel-jest",
                {
                    "presets": [
                        [
                            "@babel/preset-env",
                            {
                                "targets": {
                                    "node": "current"
                                }
                            }
                        ]
                    ]
                }
            ]
        },
        "transformIgnorePatterns": [
            "node_modules/(?!(jose)/)"
        ]
    },
    "private": true,
    "overrides": {
        "qs": "^6.16.0",
        "minimatch": ">=9.0.5",
        "uuid": "^11.1.1",
        "js-yaml": "^4.2.0"
    }
}
