rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {



    // === 헬퍼 함수 (Custom Claims 기반 — get() 호출 없이 빠른 검증) ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.role == 'superAdmin';
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && request.auth.token.orgId == orgId;
    }

    // 행위자 스탬프(lastEditedByUid) 검증 — 접속기록의 '계정' 항목 (고시 제16조).
    //
    // 트리거는 호출자를 알 수 없으므로 클라이언트가 자기 uid를 심고, Rules가 그 값이
    // 인증 토큰과 일치함을 보장한다. 그래서 **타인 명의로는 위조할 수 없다**.
    //
    // "변경될 때만" 검사하는 이유: 모든 update에 스탬프를 요구하면 스탬프를 심지 않는
    // 경로가 하나라도 남아 있을 때 그 기능이 통째로 permission-denied가 된다
    // (Phase 129에서 Rules가 클라이언트 경로보다 좁아 다일·반복 예약 수정이 전부
    // 실패했던 것과 같은 함정). 생략은 여전히 가능하지만 그 경우 감사 로그에
    // actorSource:'unknown'으로 남아 **누락이 조용히 성공으로 위장되지 않는다**.
    function actorStampValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastEditedByUid'])
             || request.resource.data.lastEditedByUid == request.auth.uid;
    }

    /**
     * 도착 km는 출발 km보다 크거나 같아야 한다.
     *
     * 화면은 이미 막는다(validateDriveLogForm) — 오타는 여기까지 오지 않는다. 그래도 두는
     * 이유는 클라이언트 우회로 '불가능한 값'이 들어오는 것을 서버에서 끊기 위해서다.
     * 위조를 막지는 못한다(마음먹으면 그럴듯한 숫자를 화면으로 넣는다). 목적은 정합성이다 —
     * 내보내기(PDF·Excel)가 음수 주행거리를 방어하는 코드를 들고 있을 필요가 없어진다.
     *
     * **두 필드가 다 있을 때만 비교한다.** 한쪽만 가진 문서나 도착 km가 아직 없는 기록을
     * 막지 않기 위해서다. update에서 '바뀔 때만' 검사하는 것은 호출부에서 처리한다
     * (actorStampValid와 같은 이유 — 모든 update에 요구하면 이미 어긋난 옛 기록의
     *  목적지 하나 고치는 것까지 permission-denied가 된다. Phase 129·132에서 실증된 함정).
     */
    function kmOrderValid() {
      return !request.resource.data.keys().hasAll(['startKm', 'endKm'])
             || request.resource.data.endKm >= request.resource.data.startKm;
    }

    /**
     * 금액·거리 필드가 음수로 저장되는 것을 막는다.
     *
     * 화면이 먼저 막지만(각 훅의 validateNonNegativeFields), driveLogs의 startKm과 같은 이유로
     * 서버에도 둔다 — 클라이언트를 우회한 '불가능한 값'을 끊어 집계·내보내기가 음수를
     * 방어하지 않아도 되게 만든다.
     *
     * **필드가 없거나 null이면 통과한다.** 비용·주행거리는 선택 항목이라 null로 저장되며,
     * 이를 막으면 미입력 저장이 통째로 거부된다.
     */
    function fieldNonNegative(data, field) {
      return !data.keys().hasAny([field])
             || data.get(field, 0) == null
             || data.get(field, 0) >= 0;
    }

    /**
     * update에서는 **그 필드가 실제로 바뀔 때만** 부호를 검사한다.
     * 모든 update에 요구하면 이미 음수가 박힌 옛 기록의 다른 필드(정비소 이름 등)를
     * 고치는 것까지 permission-denied가 된다 — kmOrderValid와 같은 함정(Phase 129·132).
     */
    function fieldNonNegativeOnChange(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
             || fieldNonNegative(request.resource.data, field);
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId)
        && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userOrgId() {
      return request.auth.token.orgId;
    }

    function belongsToMyOrg() {
      return isSignedIn() && resource.data.organizationId == userOrgId();
    }

    function newBelongsToMyOrg() {
      return isSignedIn() && request.resource.data.organizationId == userOrgId();
    }

    // === 사용자 ===
    match /users/{userId} {
      // 자기 자신 + superAdmin + 같은 기관 멤버만 읽기 가능.
      // organizationId != null 조건이 없으면 "null == null"이 참이 되어, 기관 미소속
      // (탈퇴·이동 대기, orgId 클레임 null) 계정끼리 서로의 문서(이메일·이름·연락처)를
      // 읽을 수 있다 — 미소속 사용자는 어떤 기관의 멤버도 아니므로 본인 외 열람 불가.
      allow read: if isOwner(userId)
                  || isSuperAdmin()
                  || (isSignedIn()
                      && resource != null
                      && resource.data.organizationId != null
                      && resource.data.organizationId == userOrgId());
      // consent(이용약관 동의 기록)는 joinOrganization(Admin SDK)만 기록한다.
      // 클라이언트가 심으면 동의하지 않은 계정에 동의 기록이 생겨 입증 자료가 무의미해진다.
      allow create: if isOwner(userId)
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.keys().hasAll(['email'])
                    && request.resource.data.email is string
                    && !request.resource.data.keys().hasAny(['role', 'organizationId', 'consent']);
      // consent 필드는 본인·기관관리자·superAdmin 누구도 값을 바꿀 수 없다.
      // (문서 자체의 삭제는 아래 allow delete가 superAdmin에게 허용하며,
      //  Admin SDK 서버 경로는 Rules를 우회하므로 필드 단위 보호로 한정된다.)
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent'])
                    && actorStampValid()
                    && (
                       (isOwner(userId)
                        && (
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organizationId', 'status', 'disabledAt'])
                            || (
                                // 사용자가 스스로 기관을 탈퇴/초기화하여 '다른 기관으로 가입'하는 행위 허용
                                request.resource.data.organizationId == null
                                && request.resource.data.role == 'employee'
                                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'disabledAt'])
                            )
                        ))
                    || isSuperAdmin()
                    // orgAdmin은 소속 기관 사용자만 수정 가능하되, superAdmin 역할 부여 불가.
                    // organizationId는 불변으로 강제한다 — admin이 자기/타인 문서의 org를 바꿔
                    // 타 기관 admin 클레임을 획득하는 교차 테넌트 권한상승을 차단(2026-07-04 감사 N1).
                    || (isOrgAdmin(resource.data.organizationId)
                        && request.resource.data.role != 'superAdmin'
                        && request.resource.data.organizationId == resource.data.organizationId)
                    );
      allow delete: if isSuperAdmin();

      // 비밀 사용자 데이터 (Google OAuth access/refresh 토큰 등) — Cloud Functions(Admin SDK) 전용.
      // 과거 users 문서에 googleOauth를 저장해 같은 기관 멤버 누구나 리프레시 토큰을 읽어
      // 계정을 임퍼소네이션할 수 있었음 (2026-07-10 감사 #4).
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // === 기관 ===
    match /organizations/{orgId} {
      // 소속 멤버, 신청자 본인, superAdmin만 읽기 가능 (초대 코드 검증은 Cloud Function에서 처리)
      allow read: if isSuperAdmin()
                  || isOrgMember(orgId)
                  || (isSignedIn() && resource.data.applicantUid == request.auth.uid);
      // 기관 생성은 서버(submitOrgApplication, Admin SDK) 또는 superAdmin 전용.
      // 과거 클라이언트 create는 status:'approved'·inviteCode를 임의 지정해 AI 검증·
      // superAdmin 승인 절차를 통째로 우회할 수 있었음 (2026-07-10 감사 #2).
      // create에서도 consent를 심을 수 없다 — 막지 않으면 superAdmin이 클라이언트에서
      // 임의 동의 기록을 가진 기관을 만들 수 있어 update 차단이 무의미해진다.
      allow create: if isSuperAdmin() && !('consent' in request.resource.data);
      // 동의 기록(consent)은 위탁 계약 성립의 입증 자료이므로 어떤 클라이언트도 변경·삭제할 수 없다.
      // submitOrgApplication(Admin SDK)만 기록하며, 규칙을 우회하는 서버 경로로만 갱신한다.
      allow update: if (isOrgAdmin(orgId) || isSuperAdmin()
                    || (isSignedIn() && resource.data.status == 'pending' && resource.data.applicantUid == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role'])))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent']);
      allow delete: if isSuperAdmin();

      // 커스텀 휴일 (서브컬렉션)
      match /customHolidays/{holidayId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // 직원 사전 등록 (서브컬렉션)
      match /preRegistered/{preRegId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // 집계 통계 (서브컬렉션 — Cloud Functions에서 생성/갱신)
      match /stats/{statId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        allow write: if false; // Cloud Functions(admin SDK)에서만 쓰기
      }
    }

    // === 차량 ===
    match /vehicles/{vehicleId} {
      allow read: if belongsToMyOrg() || isSuperAdmin();
      allow create: if ((newBelongsToMyOrg() && isOrgAdmin(request.resource.data.organizationId)) || isSuperAdmin())
                    && (!request.resource.data.keys().hasAny(['currentKm']) || request.resource.data.currentKm >= 0);
      allow update: if isSuperAdmin()
                    // organizationId는 불변 — admin이 차량을 타 기관으로 이전해 통계·주행거리를
                    // 오염시키는 교차 테넌트 무결성 침해 차단 (2026-07-10 감사 #6).
                    || (isOrgAdmin(resource.data.organizationId)
                        && request.resource.data.organizationId == resource.data.organizationId
                        && (!request.resource.data.keys().hasAny(['currentKm']) || request.resource.data.currentKm >= 0))
                    // 소속 기관 멤버가 운행일지 저장 시 currentKm만 갱신 가능 (감소 방지)
                    || (isOrgMember(resource.data.organizationId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentKm'])
                        && request.resource.data.currentKm >= resource.data.currentKm
                        && request.resource.data.currentKm >= 0);
      allow delete: if isOrgAdmin(resource.data.organizationId) || isSuperAdmin();
    }

    // === 하이패스 카드 ===
    match /hipassCards/{cardId} {
      allow read: if belongsToMyOrg() || isSuperAdmin();
      allow create: if (newBelongsToMyOrg() && isOrgAdmin(request.resource.data.organizationId))
                    || isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (isOrgAdmin(resource.data.organizationId)
                        && request.resource.data.organizationId == resource.data.organizationId)
                    // 소속 기관 멤버가 충전 시 balance만 갱신 가능 (음수 방지)
                    || (isOrgMember(resource.data.organizationId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt'])
                        && request.resource.data.balance >= 0);
      allow delete: if isOrgAdmin(resource.data.organizationId) || isSuperAdmin();
    }

    // === 운행일지 ===
    match /driveLogs/{logId} {
      allow read: if belongsToMyOrg() || isSuperAdmin();
      // 작성자(createdByUid)만 생성 가능. driverUid(대표 운전자)는 작성자가 타인으로 지정할 수 있으므로
      // 소유자 판정 기준을 createdByUid로 분리 (2026-07-17 운전자 지정 기능).
      // 슈퍼관리자는 지원·테스트 목적으로 어느 기관에서든 생성 가능(작성자 위조는 여전히 금지).
      allow create: if (isSuperAdmin() || newBelongsToMyOrg())
                    && request.resource.data.keys().hasAll(['organizationId', 'vehicleId', 'driverUid', 'createdByUid'])
                    && request.resource.data.createdByUid == request.auth.uid
                    && (!request.resource.data.keys().hasAny(['startKm']) || request.resource.data.startKm >= 0)
                    && (!request.resource.data.keys().hasAny(['endKm']) || request.resource.data.endKm >= 0)
                    && kmOrderValid();
      allow update: if (isSuperAdmin()
                    || (belongsToMyOrg() && (
                        // 소유자(작성자)는 driverUid(대표 운전자) 포함 정보 수정 가능. createdByUid는 폴백으로 구 데이터 호환.
                        // organizationId·vehicleId·createdByUid는 불변.
                        ((resource.data.createdByUid == request.auth.uid
                            || (!('createdByUid' in resource.data) && resource.data.driverUid == request.auth.uid))
                            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId', 'vehicleId', 'createdByUid']))
                        // organizationId 불변 — admin의 타 기관 이전 차단 (2026-07-10 감사 #6)
                        || (isOrgAdmin(resource.data.organizationId) && request.resource.data.organizationId == resource.data.organizationId)
                    )))
                    && actorStampValid()
                    && (!request.resource.data.keys().hasAny(['startKm']) || request.resource.data.startKm >= 0)
                    && (!request.resource.data.keys().hasAny(['endKm']) || request.resource.data.endKm >= 0)
                    // km를 건드리는 수정만 순서를 검사한다. 이미 어긋난 옛 기록의 다른 필드를
                    // 고치는 길은 열어 둔다(막으면 그 기록을 아예 손볼 수 없게 된다).
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['startKm', 'endKm'])
                        || kmOrderValid());
      allow delete: if isOrgAdmin(resource.data.organizationId) || isSuperAdmin();
    }

    // === 예약 ===
    match /reservations/{reservationId} {
      allow read: if belongsToMyOrg() || isSuperAdmin();
      // 예약 생성은 createReservationSafe(콜러블, Admin SDK) 전용.
      // 클라이언트 직접 create는 allowedUserIds(차량 사용 제한)·시간 중복·승인 필요 여부
      // 검증을 우회할 수 있었음 (2026-07-10 감사 #5).
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (belongsToMyOrg() && (
                        // 소유자는 취소·운행 종료·정보 수정만 가능. pending→reserved 자가 승인은 차단
                        // (requireReservationApproval 우회 방지 — 승인은 admin만).
                        (resource.data.reservedByUid == request.auth.uid
                            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId', 'reservedByUid'])
                            && !(resource.data.status == 'pending' && request.resource.data.status == 'reserved'))
                        // organizationId 불변 — admin의 타 기관 이전 차단 (2026-07-10 감사 #6)
                        || (isOrgAdmin(resource.data.organizationId) && request.resource.data.organizationId == resource.data.organizationId)
                    ));
      // 다일·반복 예약 그룹 수정은 "기존 그룹 삭제 → 재생성" 경로라 삭제 권한이 필요하다.
      // superAdmin 전용이던 탓에 소유자 본인조차 그룹 수정이 항상 permission-denied로
      // 실패했다 (2026-07-31 에뮬레이터 재현).
      //
      // 기관 관리자를 한동안 제외했던 이유는 명의 이전이었다 — createReservationSafe가
      // reservedByUid를 호출자로 강제해서, 관리자가 직원 그룹을 수정하면 재생성된 예약의
      // 명의가 관리자로 조용히 넘어갔다. **그 결함을 서버에서 먼저 고쳤으므로**
      // (createReservationCore가 reservedByUid를 받아 기관 구성원 여부를 확인하고 명의를
      // 보존한다) 이제 관리자 경로를 연다. 관리자는 이미 같은 기관 예약을 update로 수정할
      // 수 있으니, 그룹 수정만 막혀 있는 것은 경계가 아니라 반쪽짜리 제약이었다.
      //
      // 타 기관은 belongsToMyOrg()·isOrgAdmin(resource.data.organizationId)로 계속 막힌다.
      allow delete: if isSuperAdmin()
                    || (belongsToMyOrg() && (
                        resource.data.reservedByUid == request.auth.uid
                        || isOrgAdmin(resource.data.organizationId)
                    ));
    }

    // === 알림 ===
    match /notifications/{notificationId} {
      allow read: if resource.data.targetUid == request.auth.uid || isSuperAdmin();
      // 클라이언트 생성은 superAdmin 전용 (승인/반려 알림 화면). 나머지 알림은 전부
      // Cloud Functions(admin SDK, Rules 우회)가 생성한다.
      // 과거 isSignedIn() 분기는 targetUid 소속 검증이 없어 임의 사용자가 타 기관
      // UID로 알림 텍스트를 주입할 수 있었음 (2026-07-03 감사 발견으로 제거).
      allow create: if isSuperAdmin();
      allow update: if resource.data.targetUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if resource.data.targetUid == request.auth.uid || isSuperAdmin();
    }

    // === 접속기록/변경 로그 ===
    // Cloud Functions(Admin SDK) 트리거만 기록하며, 클라이언트는 생성·수정·삭제를 전부
    // 할 수 없다. 읽기는 점검 주체에게만 연다 — 개인정보처리자는 각 기관이므로
    // (이용약관 제9조) 기관 관리자가 자기 기관 기록을 점검한다.
    //
    // ⚠️ 이 블록이 막는 것은 **클라이언트의** 위조·변조다. Admin SDK는 Rules를 우회하므로
    // 고시 제16조 ③(위조·변조·도난·분실 방지)을 이것만으로 충족한다고 볼 수 없다. 서버 측
    // 불변성은 별도 수단(불변 버킷·Cloud Logging 싱크 등)이 필요하며 현재 범위 밖이다.
    //
    // organizationId가 '__system__'인 기록(기관 미소속 계정, 주로 superAdmin)은 실재하는
    // 기관 ID가 아니므로 isOrgAdmin이 성립하지 않아 superAdmin만 읽는다.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isOrgAdmin(resource.data.organizationId);
      allow write: if false;
    }

    // === 전체 공지 발송 이력 ===
    // sendBroadcastNotice(Admin SDK)만 기록한다. 운영자가 "언제 무엇을 몇 명에게
    // 보냈는가"를 화면에서 확인하기 위한 기록이므로 읽기도 superAdmin 한정이다.
    // 본문에 기관·이용자 정보가 담기지 않으나, 발송자 uid가 있어 공개할 이유가 없다.
    match /broadcasts/{broadcastId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // === 즐겨찾기 ===
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // === 주유 기록 ===
    match /fuelLogs/{logId} {
      allow read: if belongsToMyOrg() || isSuperAdmin();
      allow create: if newBelongsToMyOrg()
                    && request.resource.data.keys().hasAll(['organizationId', 'vehicleId', 'driverUid'])
                    && request.resource.data.driverUid == request.auth.uid
                    // 계기판·주유량·금액은 음수가 될 수 없다
                    && fieldNonNegative(request.resource.data, 'meterReading')
                    && fieldNonNegative(request.resource.data, 'fuelAmount')
                    && fieldNonNegative(request.resource.data, 'fuelCost');
      allow update: if (isSuperAdmin()
                    || (belongsToMyOrg() && (
                        (resource.data.driverUid == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId', 'vehicleId', 'driverUid']))
                        // organizationId 불변 — admin의 타 기관 이전 차단 (2026-07-10 감사 #6)
                        || (isOrgAdmin(resource.data.organizationId) && request.resource.data.organizationId == resource.data.organizationId)
                    )))
                    && fieldNonNegativeOnChange('meterReading')
                    && fieldNonNegativeOnChange('fuelAmount')
                    && fieldNonNegativeOnChange('fuelCost');
      allow delete: if (belongsToMyOrg()
                    && (resource.data.driverUid == request.auth.uid
                        || isOrgAdmin(resource.data.organizationId)))
                    || isSuperAdmin();
    }

    // === 하이패스 충전 기록 ===
    match /hipassCharges/{chargeId} {
      allow read: if belongsToMyOrg() || isSuperAdmin();
      allow create: if newBelongsToMyOrg()
                    && request.resource.data.keys().hasAll(['organizationId', 'cardId', 'chargerUid'])
                    && request.resource.data.chargerUid == request.auth.uid
                    // 충전금액은 음수가 될 수 없다.
                    // balanceBefore·balanceAfter는 카드의 현재 상태를 옮겨 적은 값이라 검사하지 않는다 —
                    // 이미 음수가 된 카드에 충전 기록을 남기는 길까지 막히면 복구가 불가능해진다.
                    && fieldNonNegative(request.resource.data, 'chargeAmount');
      allow update: if (isSuperAdmin()
                    || (belongsToMyOrg() && (
                        (resource.data.chargerUid == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId', 'cardId', 'chargerUid']))
                        // organizationId 불변 — admin의 타 기관 이전 차단 (2026-07-10 감사 #6)
                        || (isOrgAdmin(resource.data.organizationId) && request.resource.data.organizationId == resource.data.organizationId)
                    )))
                    && fieldNonNegativeOnChange('chargeAmount');
      allow delete: if (belongsToMyOrg()
                    && (resource.data.chargerUid == request.auth.uid
                        || isOrgAdmin(resource.data.organizationId)))
                    || isSuperAdmin();
    }

    // === 정비 기록 ===
    match /maintenanceRecords/{recordId} {
      allow read: if belongsToMyOrg() || isSuperAdmin();
      allow create: if (isSuperAdmin()
                    || (newBelongsToMyOrg() && isOrgAdmin(request.resource.data.organizationId))
                    // 직원 본인 작성 — 차량 차단(blockVehicle) 권한은 관리자 전용이므로 false만 허용
                    || (newBelongsToMyOrg()
                        && request.resource.data.keys().hasAll(['organizationId', 'vehicleId', 'createdByUid'])
                        && request.resource.data.createdByUid == request.auth.uid
                        && request.resource.data.blockVehicle == false))
                    // 비용·주행거리는 음수가 될 수 없다 (미입력은 null이라 통과)
                    && fieldNonNegative(request.resource.data, 'cost')
                    && fieldNonNegative(request.resource.data, 'km')
                    && fieldNonNegative(request.resource.data, 'nextDueKm');
      allow update: if (isSuperAdmin()
                    // organizationId 불변 — admin의 타 기관 이전 차단 (2026-07-10 감사 #6)
                    || (isOrgAdmin(resource.data.organizationId)
                        && request.resource.data.organizationId == resource.data.organizationId)
                    // 직원 본인 작성 건만 수정 — 소유자·기관·차량 불변, 차량 차단 불가
                    || (belongsToMyOrg()
                        && resource.data.createdByUid == request.auth.uid
                        && request.resource.data.createdByUid == resource.data.createdByUid
                        && request.resource.data.organizationId == resource.data.organizationId
                        && request.resource.data.vehicleId == resource.data.vehicleId
                        && request.resource.data.blockVehicle == false))
                    && fieldNonNegativeOnChange('cost')
                    && fieldNonNegativeOnChange('km')
                    && fieldNonNegativeOnChange('nextDueKm');
      allow delete: if isOrgAdmin(resource.data.organizationId) || isSuperAdmin()
                    // 직원 본인 작성 건 삭제
                    || (belongsToMyOrg() && resource.data.createdByUid == request.auth.uid);
    }

    // === 피드백 ===
    //
    // create가 `isSignedIn()` 하나였을 때, 로그인한 누구나 이 컬렉션에 문서를 무제한으로
    // 밀어 넣을 수 있었다. 그런데 이 컬렉션의 onCreate(generateFeedbackDraft)는 Discord
    // 웹훅·첨부 이미지 다운로드·**Gemini 호출**을 연쇄로 실행한다 — 즉 클라이언트 쓰기가
    // 곧 서버 비용이었다 (2026-08-14 감사 발견 1).
    //
    // 여기서 막는 것은 "한 번의 쓰기가 얼마나 큰 일을 시킬 수 있는가"다(작성자 위조 금지,
    // 첨부 개수·본문 길이 상한). **호출 횟수 자체의 상한은 Rules로 표현할 수 없으므로**
    // 트리거 안의 일일 쿼터(GLOBAL_BUDGETS.feedbackAiDraft*)가 짝을 이룬다. 둘 중 하나만
    // 있으면 반쪽이다.
    match /feedbacks/{feedbackId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn()
                    // 타인 명의로 의견을 심을 수 없다 (서버 경로인 submitPublicFeedback은
                    // Admin SDK라 Rules를 우회하므로 'public-inquiry' 표기에 영향 없음).
                    && request.resource.data.authorUid == request.auth.uid
                    // 본문 길이 — submitPublicFeedback의 상한(5000자)과 같은 기준.
                    && request.resource.data.get('message', '') is string
                    && request.resource.data.get('message', '').size() <= 5000
                    && request.resource.data.get('content', '') is string
                    && request.resource.data.get('content', '').size() <= 5000
                    // 첨부는 최대 3개 — 트리거의 fetchPromptImages maxImages와 같은 값.
                    && (!request.resource.data.keys().hasAny(['imageUrls'])
                        || (request.resource.data.imageUrls is list
                            && request.resource.data.imageUrls.size() <= 3))
                    // AI·답변 필드는 서버(트리거·superAdmin)만 채운다. 클라이언트가 미리
                    // 심으면 답변 이력이 사용자 입력으로 오염된다.
                    && !request.resource.data.keys().hasAny(['aiDraft', 'aiConfidence', 'reply', 'repliedAt', 'repliedBy']);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // === 기관 신청 ===
    match /orgApplications/{appId} {
      allow read: if isSuperAdmin()
                  || (isSignedIn() && resource.data.applicantEmail == request.auth.token.email);
      allow create: if isSignedIn()
                    && request.resource.data.applicantEmail == request.auth.token.email;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // === 통계 컬렉션 ===
    match /orgStats/{orgId} {
      match /monthly/{docId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        allow write: if false; // Cloud Functions에서만 쓰기
      }
    }

    // === 시스템 ===
    match /system/{document} {
      allow read: if isSuperAdmin() || (document == 'holidays' && isSignedIn());
      allow write: if false; // Cloud Functions에서만 쓰기
    }

    // === 메신저 어시스턴트 (Slack 등) — 서버 전용, 클라이언트 접근 전면 차단 ===
    match /integrations/{docId} {
      allow read, write: if false; // 워크스페이스↔기관 매핑 (콘솔/Functions에서만 관리)
    }
    match /slackUsers/{docId} {
      allow read, write: if false; // Slack 사용자↔앱 계정 매핑 캐시
    }
    match /slackTasks/{docId} {
      allow read, write: if false; // 수신 이벤트 task 큐 (TTL 자동 정리)
    }
    match /slackConfirmations/{docId} {
      allow read, write: if false; // 예약 확인 대기 문서 (TTL 자동 정리)
    }
    match /assistantConversations/{docId} {
      allow read, write: if false; // 멀티턴 대화 상태(진행 중 예약 슬롯) (TTL 자동 정리)
    }
    match /assistantVehicleCache/{docId} {
      allow read, write: if false; // 어시스턴트 차량 목록 캐시 (TTL 자동 정리)
    }
    match /slackOauthStates/{docId} {
      allow read, write: if false; // OAuth 설치 nonce(1회성) (TTL 자동 정리)
    }
    match /tmapCache/{docId} {
      allow read, write: if false; // TMAP 지오코딩·경로 결과 캐시 (TTL 자동 정리)
    }
  }
}
