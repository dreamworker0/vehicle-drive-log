# === 프론트엔드 환경변수 템플릿 ===
# 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 .gitignore 대상이다.
# CI/배포는 이 파일을 쓰지 않고 GitHub Secrets(ENV_FILE)로 `.env`를 생성한다.
#
# ⚠️ VITE_ 접두사가 붙은 값은 빌드 시 프론트엔드 번들에 그대로 박혀 공개 배포된다.
#    따라서 여기에는 "공개돼도 되는 값"만 넣는다. 서버 전용 비밀은 절대 금지.
#    (서버 비밀은 Secret Manager 또는 functions/.env를 쓴다)

# --- 빌드 필수 (6개) ---
# 하나라도 비면 prebuild(scripts/generate-sw-config.ts)가 빌드를 중단한다.
# Firebase Console → 프로젝트 설정 → 내 앱 → SDK 설정 및 구성에서 확인.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 선택 (없으면 해당 기능만 비활성) ---
# GA4 측정 ID
VITE_FIREBASE_MEASUREMENT_ID=
# FCM 웹 푸시 VAPID 공개키 (Console → 클라우드 메시징 → 웹 푸시 인증서)
VITE_FIREBASE_VAPID_KEY=
# App Check reCAPTCHA v3 사이트 키 (site key는 공개 전제 값)
VITE_RECAPTCHA_SITE_KEY=
# Sentry 프론트엔드 DSN
VITE_SENTRY_DSN=
# T-Map appKey — 개발 모드에서만 브라우저가 직접 사용한다.
# 프로덕션은 Cloud Functions 프록시를 거치므로 번들에 포함되지 않는다.
VITE_TMAP_API_KEY=
# 공공데이터포털 특일(공휴일) 서비스키 — T-Map과 동일하게 개발 모드 전용
VITE_HOLIDAY_API_KEY=

# 참고
# - App Check 디버그 토큰은 `.env.local`에 넣는다 → .env.local.example 참고
# - 에뮬레이터 모드는 `.env.emulator`의 VITE_USE_EMULATOR=true 를 쓴다
