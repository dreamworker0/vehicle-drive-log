{
  "name": "vehicle-drive-log",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "check:node": "tsx scripts/check-node-version.ts",
    "check:release-notes": "tsx scripts/check-release-notes.ts",
    "check:faq": "tsx scripts/check-faq-coverage.ts",
    "check:functions-env": "tsx scripts/check-functions-env.ts",
    "check:functions-catalog": "tsx scripts/check-functions-catalog.ts",
    "prebuild": "tsx scripts/check-node-version.ts && tsx scripts/generate-sw-config.ts",
    "build": "vite build",
    "postbuild": "tsx scripts/check-bundle-size.ts && tsx scripts/generate-seo.ts",
    "screenshots": "tsx scripts/generate-screenshots.ts",
    "diagram:organization": "tsx scripts/render-organization-journey.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:functions": "eslint functions --max-warnings=0",
    "type-check": "tsc --noEmit",
    "type-check:functions": "tsc --noEmit -p functions/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:rules": "npx firebase-tools emulators:exec --only firestore \"vitest run tests/firestore-rules.test.ts\"",
    "test:rules:storage": "npx firebase-tools emulators:exec --only storage \"vitest run tests/storage-rules.test.ts\"",
    "test:rules:all": "npx firebase-tools emulators:exec --only firestore,storage \"vitest run tests/firestore-rules.test.ts tests/storage-rules.test.ts\"",
    "audit": "tsx scripts/security-audit.ts",
    "harness:check": "tsx scripts/check-harness.ts",
    "verify:harness": "tsx scripts/check-harness.ts",
    "verify:fast": "npm run check:node && npm run lint && npm run type-check && npm run type-check:functions && npm run check:functions-env && npm run check:functions-catalog",
    "verify:full": "npm run verify:harness && npm run verify:fast && npm run verify:gitignore && npm run test:coverage && npm run test:functions:coverage && npm run test:functions:emulator && npm run build && npm run test:rules:all && npm run test:e2e && npm run test:e2e:emulator",
    "test:functions": "npm --prefix functions run test",
    "test:functions:coverage": "npm --prefix functions run test:coverage",
    "test:functions:emulator": "npx firebase-tools emulators:exec --only auth,firestore --project demo-vehicle-log \"npm --prefix functions run test:emulator\"",
    "verify:gitignore": "tsx scripts/verify-gitignore.ts",
    "sync:agents": "tsx scripts/sync-claude-agents.ts",
    "eval:trigger": "tsx scripts/run-eval.ts trigger",
    "eval:behavior": "tsx scripts/run-eval.ts behavior",
    "health": "tsx scripts/check-functions-health.ts",
    "pretest:e2e": "tsx scripts/check-e2e-ready.ts",
    "test:e2e": "playwright test --project=chromium --project=mobile-chrome --project=mobile-safari",
    "test:e2e:all": "playwright test",
    "lighthouse": "npm run build && npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.json",
    "test:e2e:emulator": "firebase emulators:exec --only auth,firestore \"playwright test -c playwright.emulator.config.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "web-vitals": "^6.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^14.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "minimatch": ">=9.0.5",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored --max-warnings=0",
      "vitest related --run"
    ]
  }
}
